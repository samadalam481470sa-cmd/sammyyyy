{
  "name": "fillglen",
  "version": "0.1.0",
  "private": true,
  "description": "Fillglen — live question window and autofill platform for job applications. Never submits. Never invents facts. Never runs on LinkedIn Easy Apply.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:core": "npm test -w @fillglen/core",
    "dev:api": "npm run dev -w @fillglen/api",
    "finder": "npm run finder -w @fillglen/api",
    "dev:dashboard": "npm run dev -w @fillglen/dashboard",
    "dev:extension": "npm run dev -w @fillglen/extension",
    "build": "npm run build --workspaces --if-present",
    "build:extension": "npm run build -w @fillglen/extension"
  },
  "engines": {
    "node": ">=20"
  }
}
