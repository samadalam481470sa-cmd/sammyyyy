# Optional — without these, open questions go to needs_human / review instead of AI drafts.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
# Or Anthropic:
# ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic

# Optional Discord/Slack-style webhook for review/CAPTCHA/error alerts
NOTIFY_WEBHOOK=

# Dashboard bind
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_PASSWORD=

# Set DATA_DIR when running as an installed Electron app
# DATA_DIR=
