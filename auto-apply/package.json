{
  "name": "auto-apply",
  "version": "1.0.0",
  "private": true,
  "description": "Human-in-the-loop job discovery, form fill, and tracked apply for Greenhouse/Lever/Ashby. Dry-run by default. No CAPTCHA solving, fingerprint spoofing, or proxy evasion.",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc",
    "discover": "node --import tsx src/discovery/run.ts",
    "match": "node --import tsx src/matching/run.ts",
    "worker": "node --import tsx src/worker.ts",
    "dashboard": "node --import tsx src/dashboard/server.ts",
    "start": "node --import tsx src/worker.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "playwright": "^1.50.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/node-cron": "^3.0.11",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.samadalam.autoapply",
    "productName": "Auto-Apply",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dashboard/**/*", "assets/**/*", "package.json"],
    "asarUnpack": ["node_modules/playwright-core/**", "node_modules/playwright/**", "node_modules/better-sqlite3/**"],
    "mac": { "target": "dmg", "icon": "assets/icon.png" },
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "linux": { "target": "AppImage" }
  }
}
