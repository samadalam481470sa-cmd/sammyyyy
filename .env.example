# Newport Specialty Partners Acquisition CRM
API_PORT=3001
DATABASE_PATH=./data/newport-crm.db

# Microsoft Entra ID official cloud SSO (SPA + PKCE). The client ID is public.
# Do not add a client secret. Authority stays https://login.microsoftonline.com/common.
# public/entra.json overrides this client ID at runtime so a future app can be swapped
# without a code change. Leave clientId empty there to keep the built-in default.
# SPA redirect URIs (no hash, trailing slash):
#   http://localhost:5173/
#   https://samadalam481470sa-cmd.github.io/sammyyyy/
# Meetings and Email request these delegated Graph permissions on the same app:
# Calendars.ReadWrite, OnlineMeetings.ReadWrite, Mail.Read, Mail.ReadWrite, Mail.Send, Files.ReadWrite.
# Do not add a client secret. Consent happens in the Microsoft popup.
VITE_MSAL_CLIENT_ID=2e296364-cbf0-4742-ba8f-3e0615a4e777
VITE_MSAL_TENANT=common

# development | staging | production. npm run dev stays development.
# npm run build:desktop sets production unless you override VITE_APP_ENV.
VITE_APP_ENV=development

# Optional. When set, the API connects to MongoDB in addition to SQLite.
# Never commit a real URI. GitHub Pages cannot use this; only the Express API can.
# MONGODB_URI=

# ── Shared workspace server (multi-user saving) ─────────────────────────────
# Who may sign in. With none of these set, the server refuses everyone.
# ALLOWED_EMAIL_DOMAINS=newportspecialty.com
# ALLOWED_EMAILS=sxa210220@utdallas.edu,other.person@example.com
# ALLOWED_TENANT_IDS=<Microsoft Entra tenant id>
# ADMIN_EMAILS=owner@newportspecialty.com
# Where the SQLite database lives (put it on a persistent disk).
# CRM_DB_PATH=/data/newport-crm.db
# Extra browser origins allowed to call the API (the GitHub Pages origin is built in).
# ALLOWED_ORIGINS=https://crm.newportspecialty.com
# Credential-free demo sign-in stays off unless this is 1 (local development only).
# ALLOW_DEMO_SIGNIN=0
