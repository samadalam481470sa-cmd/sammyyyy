// Newport Specialty Partners — MGA roll-up CRM / portfolio platform
//
// Minimum viable schema. Four tables, one direction of ownership:
//
//   Mga (1) ──< FinancialPeriod    historical EBITDA, one row per fiscal year
//   Mga (1) ──< InsuranceProgram   line of business / coverage / region tags
//   Mga (1) ──< RetailAgency       "the Jakes" — independent retailers the MGA distributes through
//
// Provider is SQLite so the whole platform runs with no database server. The
// model is intentionally Postgres-portable: no SQLite-specific types are used,
// and every field marked "@db"-free maps 1:1 onto Postgres. The one thing that
// changes on migration is that the String status/stage columns become native
// Postgres enums. See docs/SCHEMA.md for the field-by-field rationale and the
// list of decisions still open for Mary's confirmation.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Managing General Agent — the primary account entity in the CRM.
/// Every other table in the platform hangs off this one.
model Mga {
  id   String @id @default(cuid())
  /// URL-safe identifier used for deep links, e.g. /mgas/harborline-underwriters
  slug String @unique
  name String

  // ---- Pipeline vs. platform -------------------------------------------------
  /// Two-bucket lifecycle required by the spec: PIPELINE or ON_PLATFORM.
  /// Values come from MGA_STATUS in src/lib/taxonomy.ts.
  status String
  /// Finer-grained corp-dev stage inside the PIPELINE bucket
  /// (SOURCED, QUALIFIED, DILIGENCE, UNDER_LOI) or CLOSED once on platform.
  /// PASSED records a target the team declined, so the reason survives.
  stage  String

  // ---- Operator profile ------------------------------------------------------
  /// Years the MGA has been underwriting. Newport's thesis targets 20-30+.
  yearsOfExperience Int
  foundedYear       Int
  /// Founder / principal underwriter — the relationship owner on the MGA side.
  principalName     String
  headquartersCity  String
  headquartersState String
  /// Region tag for the MGA as a whole; individual programs carry their own.
  primaryRegion     String
  employeeCount     Int?
  website           String?

  // ---- Deal facts ------------------------------------------------------------
  /// Null until the deal closes.
  acquisitionDate     DateTime?
  /// Enterprise value at close, in whole US dollars.
  enterpriseValueUsd  Float?
  /// EV / trailing EBITDA at close for platform companies; ask multiple for pipeline.
  ebitdaMultiple      Float?
  /// Newport's ownership after close, 0-100.
  ownershipPercent    Float?
  /// Internal corp-dev owner of the relationship.
  dealLead            String?
  /// Free-text diligence notes surfaced on the MGA detail screen.
  notes               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  financials     FinancialPeriod[]
  programs       InsuranceProgram[]
  retailAgencies RetailAgency[]

  @@index([status])
  @@index([primaryRegion])
}

/// Insurance client / insured account. This is the relationship layer of the
/// CRM; PolicyRow remains the operational register while this record holds the
/// people, account facts and the next action.
model Client {
  id   String @id @default(cuid())
  slug String @unique

  companyName String
  contactName String
  email       String
  phone       String?

  industry   String
  city       String
  state      String
  region     String
  mgaName    String?
  producer   String?

  annualPremiumUsd Float?
  policyCount      Int @default(0)
  /// PROSPECT, ACTIVE, RENEWAL_DUE, AT_RISK or INACTIVE.
  status String
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  followUps FollowUp[]

  @@index([status])
  @@index([region])
  @@index([email])
}

/// A next action on a client relationship. The due date can be exported as an
/// iCalendar event and opened directly in Outlook.
model FollowUp {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  /// CALL, EMAIL, MEETING, RENEWAL_REVIEW or CLAIM_CHECK_IN.
  activityType String
  dueAt        DateTime
  assignedTo   String
  notes        String?

  isCompleted Boolean @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dueAt])
  @@index([assignedTo])
  @@index([isCompleted])
}

/// One fiscal year of financials for one MGA. The time series behind every
/// EBITDA growth number on the dashboards — year-over-year deltas and CAGR are
/// derived from these rows, never stored, so the math can never drift from the
/// inputs.
model FinancialPeriod {
  id    String @id @default(cuid())
  mgaId String
  mga   Mga    @relation(fields: [mgaId], references: [id], onDelete: Cascade)

  fiscalYear Int
  revenueUsd Float
  /// EBITDA as Mary defines it: earnings before interest, bad debt and taxes.
  ebitdaUsd  Float
  /// Bad-debt add-back included in ebitdaUsd, kept separately so the platform
  /// can also report a conventional EBITDA that excludes it.
  badDebtAddbackUsd Float?
  /// Gross written premium placed through the MGA in the year.
  writtenPremiumUsd Float

  /// True once a year has audited statements behind it.
  isAudited   Boolean @default(false)
  /// True for management projections on pipeline targets. The pipeline
  /// dashboard can exclude projected years so growth is not flattered by them.
  isProjected Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mgaId, fiscalYear])
  @@index([fiscalYear])
}

/// An insurance program written by an MGA. A single MGA runs several. These
/// rows carry the three tags the synergy analysis joins on.
model InsuranceProgram {
  id    String @id @default(cuid())
  mgaId String
  mga   Mga    @relation(fields: [mgaId], references: [id], onDelete: Cascade)

  name String

  /// Tag values are drawn from the canonical lists in src/lib/taxonomy.ts.
  /// Keeping them as normalised strings (rather than lookup tables) is what
  /// makes overlap detection an exact match instead of fuzzy comparison.
  lineOfBusiness  String
  coverageType    String
  geographicRegion String

  /// Carrier whose paper the program is written on — the binding constraint on
  /// moving a program between MGAs after an acquisition.
  carrierPartner    String?
  writtenPremiumUsd Float
  /// Loss ratio as a decimal, e.g. 0.58 for 58%.
  lossRatio         Float?
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mgaId])
  @@index([lineOfBusiness])
  @@index([coverageType])
  @@index([geographicRegion])
}

/// A shared spreadsheet of policy records.
///
/// Two access models, which is the whole point of this table:
///   ORGANIZATION — every Newport user can open it. This is the main company
///                  book of record; `isPrimary` marks the one that opens by
///                  default and it cannot be locked down or deleted.
///   RESTRICTED   — only the people listed in WorkbookMember can open it, each
///                  invited by email address.
model Workbook {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?

  /// ORGANIZATION or RESTRICTED. See WORKBOOK_ACCESS in src/lib/workbook.ts.
  accessMode String
  /// Exactly one workbook is primary: the company-wide book everyone lands on.
  isPrimary  Boolean @default(false)

  ownerEmail String
  ownerName  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members WorkbookMember[]
  rows    PolicyRow[]

  @@index([accessMode])
}

/// A person granted access to a restricted workbook, identified by email.
///
/// Organization-wide workbooks also carry member rows, but only to record an
/// explicit role — absence of a row there means "default viewer", not "no
/// access". On a restricted workbook, absence of a row means no access at all.
model WorkbookMember {
  id         String   @id @default(cuid())
  workbookId String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  email String
  name  String?
  /// OWNER, EDITOR or VIEWER. See WORKBOOK_ROLE in src/lib/workbook.ts.
  role  String
  /// INVITED until the person first opens the workbook, then ACTIVE.
  status String @default("INVITED")

  invitedAt    DateTime  @default(now())
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per person per workbook, so re-inviting updates rather than
  // silently creating a second grant with a different role.
  @@unique([workbookId, email])
  @@index([email])
}

/// One row of the insurance spreadsheet: a policy or a submission working its
/// way toward bound.
model PolicyRow {
  id         String   @id @default(cuid())
  workbookId String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  /// Position in the sheet. Sparse on purpose so a row can be inserted between
  /// two others without renumbering the whole book.
  sortOrder Int

  policyNumber String
  insuredName  String
  /// Free text rather than a foreign key: a submission can name an MGA the CRM
  /// has never heard of, and the sheet must not reject it.
  mgaName      String?
  lineOfBusiness   String
  coverageType     String
  geographicRegion String
  carrier          String?
  producerAgency   String?
  underwriter      String?

  effectiveDate  DateTime?
  expirationDate DateTime?

  premiumUsd     Float?
  commissionRate Float?

  /// SUBMITTED, QUOTED, BOUND, RENEWED, DECLINED or LAPSED.
  status String
  notes  String?

  /// Email of whoever last touched the row, shown in the grid footer.
  updatedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workbookId, sortOrder])
  @@index([status])
  @@index([lineOfBusiness])
}

/// Retail agency — "the Jakes". Independent, unrelated agencies that place
/// business through an MGA. Modelled here as one-to-many off the MGA per spec
/// (`Associated_MGA` foreign key); see docs/SCHEMA.md for the open question
/// about retailers that appoint with more than one platform MGA.
model RetailAgency {
  id    String @id @default(cuid())
  mgaId String
  mga   Mga    @relation(fields: [mgaId], references: [id], onDelete: Cascade)

  name String
  /// The individual producer who owns the relationship — the actual "Jake".
  principalName String
  city  String
  state String
  region String

  appointedOn DateTime?
  /// Premium this retailer placed through the MGA in the trailing 12 months.
  annualPremiumPlacedUsd Float?
  policyCount            Int?
  isActive               Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mgaId])
  @@index([region])
}
